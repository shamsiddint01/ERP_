# =============================================================================
# ERP backend — environment configuration
# Copy to .env and fill in real values. .env is gitignored; never commit it.
# =============================================================================

# ----- REQUIRED (production) --------------------------------------------------

# PostgreSQL connection string.
DATABASE_URL="postgresql://erp:erp_dev_password@localhost:5433/erp_db?schema=public"

# Secret used to sign the 15-minute JWT access token.
# Production: must be a strong random value of at least 32 characters, or the
# app refuses to boot. Generate one with:  openssl rand -base64 48
JWT_ACCESS_SECRET="change_me_dev_only_use_a_strong_value_in_production"

# Allowed browser origin(s) for CORS (credentialed requests). Comma-separated
# for more than one. If unset in production, cross-origin browser requests are
# blocked and a warning is logged.
CORS_ORIGIN="http://localhost:5173"

# "development" or "production". Controls: JSON logging, Swagger exposure,
# secure-cookie flag, and the strong-secret boot check.
NODE_ENV=development

# ----- OPTIONAL (have sensible defaults) ------------------------------------

# HTTP port. Default: 3000.
PORT=3001

# Redis — backs the RBAC permission cache only (falls back to Postgres if
# unavailable). Defaults: localhost / 6379.
REDIS_HOST=localhost
REDIS_PORT=6380

# Access-token lifetime (default 15m) and refresh-token / session lifetime
# (default 7d). Accept values like "15m", "24h", "7d".
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Serve Swagger at /api/docs in production. Ignored (always on) in development.
# ENABLE_SWAGGER=false

# Number of reverse-proxy hops in front of the app (1 for the provided nginx),
# or "true". Makes req.ip / rate-limiting use the real client IP. Leave unset
# when the app is exposed directly.
# TRUST_PROXY=1

# ----- DEVELOPMENT / TOOLING ONLY -----------------------------------------

# Password given to the seeded "admin" user by `pnpm db:seed`.
# Default: ChangeMe123!  — change it immediately after first login.
# SEED_ADMIN_PASSWORD=

# Encrypts the admin-visible copy of staff-set passwords. Required. Generate with: openssl rand -base64 48
CREDENTIALS_ENCRYPTION_KEY=change_me_to_a_long_random_string_of_at_least_32_chars
