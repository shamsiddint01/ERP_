generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================================
// ENUMS
// =========================================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_INVITE
}

enum PermissionAction {
  VIEW
  CREATE
  EDIT
  DELETE
  APPROVE
  EXPORT
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  DISCONTINUED
  DRAFT
}

enum StockMovementType {
  STOCK_IN
  STOCK_OUT
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT_POSITIVE
  ADJUSTMENT_NEGATIVE
}

enum StockReferenceType {
  PURCHASE
  SALE
  TRANSFER
  ADJUSTMENT
  RETURN
  DAMAGED
}

enum StockTransferStatus {
  DRAFT
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING
  APPROVED
  RECEIVED
  PARTIALLY_RECEIVED
  CANCELLED
}

// Shared payment-status lifecycle for Order and PurchaseOrder
enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum PaymentDirection {
  INBOUND
  OUTBOUND
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  ONLINE
  CHEQUE
}

enum PaymentProcessingStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// Polymorphic discriminator for Payment.referenceId (no DB-level FK; enforced in application layer)
enum PaymentReferenceType {
  ORDER
  INVOICE
  PURCHASE_ORDER
  EXPENSE
  OTHER
}

enum AccountType {
  CASH
  BANK
  RECEIVABLE
  PAYABLE
  REVENUE
  EXPENSE
  EQUITY
}

enum TransactionType {
  SALE_REVENUE
  PURCHASE_EXPENSE
  PAYMENT_IN
  PAYMENT_OUT
  EXPENSE
  REFUND
  ADJUSTMENT
  TRANSFER
}

// Polymorphic discriminator for Transaction.referenceId (no DB-level FK; enforced in application layer)
enum TransactionReferenceType {
  ORDER
  PURCHASE_ORDER
  PAYMENT
  EXPENSE
  INVOICE
  MANUAL
}

enum ExpenseStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
  HOLIDAY
}

enum ReportType {
  SALES
  PURCHASE
  REVENUE
  EXPENSE
  PROFIT
  INVENTORY
  CUSTOMER
  SUPPLIER
  PAYMENT
  EMPLOYEE
}

enum ReportFormat {
  CSV
  EXCEL
  PDF
}

enum ReportJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum NotificationType {
  NEW_ORDER
  NEW_PAYMENT
  LOW_STOCK
  INVOICE_DUE
  DEBT_REMINDER
  NEW_EMPLOYEE
  SYSTEM_WARNING
}

enum OutboxEventStatus {
  PENDING
  PROCESSED
  FAILED
}

// =========================================================================
// 1. USERS & ROLES (RBAC)
// =========================================================================

model User {
  id           String     @id @default(uuid())
  fullName     String     @map("full_name")
  email        String     @unique
  phone        String?    @unique
  username     String     @unique
  passwordHash String     @map("password_hash")
  avatarUrl    String?    @map("avatar_url")
  roleId       String     @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id])
  employeeId   String?    @unique @map("employee_id")
  employee     Employee?  @relation(fields: [employeeId], references: [id])
  status       UserStatus @default(PENDING_INVITE)
  lastActiveAt DateTime?  @map("last_active_at")
  deletedAt    DateTime?  @map("deleted_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  sessions                UserSession[]
  auditLogs               AuditLog[]        @relation("AuditActor")
  notifications           Notification[]
  createdPurchaseOrders   PurchaseOrder[]   @relation("PurchaseOrderCreatedBy")
  approvedPurchaseOrders  PurchaseOrder[]   @relation("PurchaseOrderApprovedBy")
  recordedPayments        Payment[]         @relation("PaymentRecordedBy")
  createdExpenses         Expense[]         @relation("ExpenseCreatedBy")
  createdTransactions     Transaction[]     @relation("TransactionCreatedBy")
  stockMovements          StockMovement[]   @relation("StockMovementPerformedBy")
  requestedStockTransfers StockTransfer[]   @relation("StockTransferRequestedBy")
  requestedReportJobs     ReportExportJob[] @relation("ReportJobRequestedBy")

  @@map("users")
}

model Role {
  id           String   @id @default(uuid())
  name         String   @unique
  description  String?
  isSystemRole Boolean  @default(false) @map("is_system_role")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id        String           @id @default(uuid())
  module    String
  action    PermissionAction
  createdAt DateTime         @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String     @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@map("user_sessions")
}

// =========================================================================
// 3. CUSTOMERS
// =========================================================================

model Customer {
  id          String         @id @default(uuid())
  name        String
  companyName String?        @map("company_name")
  phone       String
  email       String?
  address     String?
  status      CustomerStatus @default(ACTIVE)
  balance     Decimal        @default(0) @db.Decimal(18, 2)
  creditLimit Decimal        @default(0) @map("credit_limit") @db.Decimal(18, 2)
  notes       String?
  deletedAt   DateTime?      @map("deleted_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  orders   Order[]
  invoices Invoice[]
  payments Payment[] @relation("PaymentPayerCustomer")

  @@map("customers")
}

// =========================================================================
// 4. PRODUCTS
// =========================================================================

model Category {
  id               String     @id @default(uuid())
  name             String
  parentCategoryId String?    @map("parent_category_id")
  parentCategory   Category?  @relation("CategoryToSubcategory", fields: [parentCategoryId], references: [id])
  subcategories    Category[] @relation("CategoryToSubcategory")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Product {
  id            String        @id @default(uuid())
  name          String
  sku           String        @unique
  barcode       String?       @unique
  categoryId    String?       @map("category_id")
  category      Category?     @relation(fields: [categoryId], references: [id])
  description   String?
  salePrice     Decimal       @map("sale_price") @db.Decimal(18, 2)
  costPrice     Decimal       @map("cost_price") @db.Decimal(18, 2)
  taxRateId     String?       @map("tax_rate_id")
  taxRate       TaxRate?      @relation(fields: [taxRateId], references: [id])
  unit          String
  minStockLevel Decimal       @default(0) @map("min_stock_level") @db.Decimal(18, 3)
  status        ProductStatus @default(DRAFT)
  deletedAt     DateTime?     @map("deleted_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  images             ProductImage[]
  supplierProducts   SupplierProduct[]
  inventoryStocks    InventoryStock[]
  stockMovements     StockMovement[]
  stockTransferItems StockTransferItem[]
  purchaseOrderItems PurchaseOrderItem[]
  orderItems         OrderItem[]
  invoiceItems       InvoiceItem[]

  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl  String   @map("image_url")
  isPrimary Boolean  @default(false) @map("is_primary")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("product_images")
}

// =========================================================================
// 5. INVENTORY
// =========================================================================

model Warehouse {
  id        String   @id @default(uuid())
  name      String
  code      String?  @unique
  address   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  inventoryStocks InventoryStock[]
  stockMovements  StockMovement[]
  transfersFrom   StockTransfer[]  @relation("StockTransferFromWarehouse")
  transfersTo     StockTransfer[]  @relation("StockTransferToWarehouse")
  purchaseOrders  PurchaseOrder[]
  orders          Order[]

  @@map("warehouses")
}

// Named alias avoided: kept as InventoryStock, relation field named inventoryStocks above.
model InventoryStock {
  id               String    @id @default(uuid())
  productId        String    @map("product_id")
  product          Product   @relation(fields: [productId], references: [id])
  warehouseId      String    @map("warehouse_id")
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id])
  quantityOnHand   Decimal   @default(0) @map("quantity_on_hand") @db.Decimal(18, 3)
  quantityReserved Decimal   @default(0) @map("quantity_reserved") @db.Decimal(18, 3)
  minStockLevel    Decimal?  @map("min_stock_level") @db.Decimal(18, 3)
  version          Int       @default(0)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@unique([productId, warehouseId])
  @@map("inventory_stocks")
}

model StockMovement {
  id                String              @id @default(uuid())
  productId         String              @map("product_id")
  product           Product             @relation(fields: [productId], references: [id])
  warehouseId       String              @map("warehouse_id")
  warehouse         Warehouse           @relation(fields: [warehouseId], references: [id])
  movementType      StockMovementType   @map("movement_type")
  quantity          Decimal             @db.Decimal(18, 3)
  previousQuantity  Decimal             @map("previous_quantity") @db.Decimal(18, 3)
  balanceAfter      Decimal             @map("balance_after") @db.Decimal(18, 3)
  referenceType     StockReferenceType? @map("reference_type")
  referenceId       String?             @map("reference_id")
  unitCost          Decimal?            @map("unit_cost") @db.Decimal(18, 2)
  performedByUserId String?             @map("performed_by_user_id")
  performedBy       User?               @relation("StockMovementPerformedBy", fields: [performedByUserId], references: [id])
  note              String?
  createdAt         DateTime            @default(now()) @map("created_at")

  @@index([productId, warehouseId])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

model StockTransfer {
  id                String              @id @default(uuid())
  fromWarehouseId   String              @map("from_warehouse_id")
  fromWarehouse     Warehouse           @relation("StockTransferFromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouseId     String              @map("to_warehouse_id")
  toWarehouse       Warehouse           @relation("StockTransferToWarehouse", fields: [toWarehouseId], references: [id])
  status            StockTransferStatus @default(DRAFT)
  requestedByUserId String?             @map("requested_by_user_id")
  requestedBy       User?               @relation("StockTransferRequestedBy", fields: [requestedByUserId], references: [id])
  completedAt       DateTime?           @map("completed_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  items StockTransferItem[]

  @@map("stock_transfers")
}

model StockTransferItem {
  id              String        @id @default(uuid())
  stockTransferId String        @map("stock_transfer_id")
  stockTransfer   StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  productId       String        @map("product_id")
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Decimal       @db.Decimal(18, 3)

  @@map("stock_transfer_items")
}

// =========================================================================
// 6. SUPPLIERS
// =========================================================================

model Supplier {
  id            String         @id @default(uuid())
  companyName   String         @map("company_name")
  contactPerson String         @map("contact_person")
  phone         String
  email         String?
  address       String?
  balance       Decimal        @default(0) @db.Decimal(18, 2)
  status        SupplierStatus @default(ACTIVE)
  notes         String?
  deletedAt     DateTime?      @map("deleted_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  supplierProducts SupplierProduct[]
  purchaseOrders   PurchaseOrder[]
  payments         Payment[]         @relation("PaymentPayeeSupplier")

  @@map("suppliers")
}

model SupplierProduct {
  id          String   @id @default(uuid())
  supplierId  String   @map("supplier_id")
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productId   String   @map("product_id")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierSku String?  @map("supplier_sku")
  unitCost    Decimal  @map("unit_cost") @db.Decimal(18, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([supplierId, productId])
  @@map("supplier_products")
}

// =========================================================================
// 7. PURCHASES
// =========================================================================

model PurchaseOrder {
  id               String              @id @default(uuid())
  poNumber         String              @unique @map("po_number")
  supplierId       String              @map("supplier_id")
  supplier         Supplier            @relation(fields: [supplierId], references: [id])
  warehouseId      String              @map("warehouse_id")
  warehouse        Warehouse           @relation(fields: [warehouseId], references: [id])
  status           PurchaseOrderStatus @default(DRAFT)
  subtotal         Decimal             @default(0) @db.Decimal(18, 2)
  taxTotal         Decimal             @default(0) @map("tax_total") @db.Decimal(18, 2)
  discountTotal    Decimal             @default(0) @map("discount_total") @db.Decimal(18, 2)
  grandTotal       Decimal             @default(0) @map("grand_total") @db.Decimal(18, 2)
  amountPaid       Decimal             @default(0) @map("amount_paid") @db.Decimal(18, 2)
  paymentStatus    PaymentStatus       @default(UNPAID) @map("payment_status")
  createdByUserId  String              @map("created_by_user_id")
  createdBy        User                @relation("PurchaseOrderCreatedBy", fields: [createdByUserId], references: [id])
  approvedByUserId String?             @map("approved_by_user_id")
  approvedBy       User?               @relation("PurchaseOrderApprovedBy", fields: [approvedByUserId], references: [id])
  approvedAt       DateTime?           @map("approved_at")
  orderDate        DateTime            @map("order_date") @db.Date
  expectedDate     DateTime?           @map("expected_date") @db.Date
  receivedAt       DateTime?           @map("received_at")
  notes            String?
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  items PurchaseOrderItem[]

  @@index([supplierId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String        @id @default(uuid())
  purchaseOrderId  String        @map("purchase_order_id")
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId        String        @map("product_id")
  product          Product       @relation(fields: [productId], references: [id])
  quantity         Decimal       @db.Decimal(18, 3)
  unitPrice        Decimal       @map("unit_price") @db.Decimal(18, 2)
  taxPercent       Decimal       @default(0) @map("tax_percent") @db.Decimal(5, 2)
  discountAmount   Decimal       @default(0) @map("discount_amount") @db.Decimal(18, 2)
  lineTotal        Decimal       @map("line_total") @db.Decimal(18, 2)
  quantityReceived Decimal       @default(0) @map("quantity_received") @db.Decimal(18, 3)

  @@map("purchase_order_items")
}

// =========================================================================
// 8/9. SALES & ORDERS (merged into a single Order entity — see plan §3.7)
// =========================================================================

model Order {
  id                    String        @id @default(uuid())
  orderNumber           String        @unique @map("order_number")
  customerId            String        @map("customer_id")
  customer              Customer      @relation(fields: [customerId], references: [id])
  warehouseId           String        @map("warehouse_id")
  warehouse             Warehouse     @relation(fields: [warehouseId], references: [id])
  status                OrderStatus   @default(DRAFT)
  paymentStatus         PaymentStatus @default(UNPAID) @map("payment_status")
  subtotal              Decimal       @default(0) @db.Decimal(18, 2)
  discountTotal         Decimal       @default(0) @map("discount_total") @db.Decimal(18, 2)
  taxTotal              Decimal       @default(0) @map("tax_total") @db.Decimal(18, 2)
  grandTotal            Decimal       @default(0) @map("grand_total") @db.Decimal(18, 2)
  amountPaid            Decimal       @default(0) @map("amount_paid") @db.Decimal(18, 2)
  responsibleEmployeeId String?       @map("responsible_employee_id")
  responsibleEmployee   Employee?     @relation(fields: [responsibleEmployeeId], references: [id])
  orderDate             DateTime      @map("order_date") @db.Date
  confirmedAt           DateTime?     @map("confirmed_at")
  completedAt           DateTime?     @map("completed_at")
  cancelledAt           DateTime?     @map("cancelled_at")
  cancellationReason    String?       @map("cancellation_reason")
  notes                 String?
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  items    OrderItem[]
  invoices Invoice[]

  @@index([customerId])
  @@index([status])
  @@index([orderDate])
  @@map("orders")
}

model OrderItem {
  id             String  @id @default(uuid())
  orderId        String  @map("order_id")
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String  @map("product_id")
  product        Product @relation(fields: [productId], references: [id])
  quantity       Decimal @db.Decimal(18, 3)
  unitPrice      Decimal @map("unit_price") @db.Decimal(18, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(18, 2)
  taxPercent     Decimal @default(0) @map("tax_percent") @db.Decimal(5, 2)
  lineTotal      Decimal @map("line_total") @db.Decimal(18, 2)

  @@map("order_items")
}

// =========================================================================
// 10. INVOICES
// =========================================================================

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique @map("invoice_number")
  customerId    String        @map("customer_id")
  customer      Customer      @relation(fields: [customerId], references: [id])
  orderId       String?       @map("order_id")
  order         Order?        @relation(fields: [orderId], references: [id])
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime      @map("issue_date") @db.Date
  dueDate       DateTime      @map("due_date") @db.Date
  subtotal      Decimal       @default(0) @db.Decimal(18, 2)
  taxTotal      Decimal       @default(0) @map("tax_total") @db.Decimal(18, 2)
  discountTotal Decimal       @default(0) @map("discount_total") @db.Decimal(18, 2)
  grandTotal    Decimal       @default(0) @map("grand_total") @db.Decimal(18, 2)
  amountPaid    Decimal       @default(0) @map("amount_paid") @db.Decimal(18, 2)
  pdfUrl        String?       @map("pdf_url")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  items InvoiceItem[]

  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

model InvoiceItem {
  id             String   @id @default(uuid())
  invoiceId      String   @map("invoice_id")
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId      String?  @map("product_id")
  product        Product? @relation(fields: [productId], references: [id])
  description    String
  quantity       Decimal  @db.Decimal(18, 3)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(18, 2)
  taxPercent     Decimal  @default(0) @map("tax_percent") @db.Decimal(5, 2)
  discountAmount Decimal  @default(0) @map("discount_amount") @db.Decimal(18, 2)
  lineTotal      Decimal  @map("line_total") @db.Decimal(18, 2)

  @@map("invoice_items")
}

// =========================================================================
// 11. PAYMENTS
// =========================================================================

model Payment {
  id                    String                  @id @default(uuid())
  paymentNumber         String                  @unique @map("payment_number")
  direction             PaymentDirection
  amount                Decimal                 @db.Decimal(18, 2)
  currency              String                  @default("UZS")
  method                PaymentMethod
  status                PaymentProcessingStatus @default(PENDING)
  payerCustomerId       String?                 @map("payer_customer_id")
  payerCustomer         Customer?               @relation("PaymentPayerCustomer", fields: [payerCustomerId], references: [id])
  payeeSupplierId       String?                 @map("payee_supplier_id")
  payeeSupplier         Supplier?               @relation("PaymentPayeeSupplier", fields: [payeeSupplierId], references: [id])
  // Polymorphic target (Order | Invoice | PurchaseOrder | Expense) — no DB FK, resolved in application layer
  referenceType         PaymentReferenceType?   @map("reference_type")
  referenceId           String?                 @map("reference_id")
  externalTransactionId String?                 @map("external_transaction_id")
  paidAt                DateTime?               @map("paid_at")
  recordedByUserId      String                  @map("recorded_by_user_id")
  recordedBy            User                    @relation("PaymentRecordedBy", fields: [recordedByUserId], references: [id])
  notes                 String?
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")

  @@index([referenceType, referenceId])
  @@index([status])
  @@map("payments")
}

// =========================================================================
// 12. FINANCE
// =========================================================================

model Account {
  id             String      @id @default(uuid())
  name           String
  type           AccountType
  currency       String      @default("UZS")
  openingBalance Decimal     @default(0) @map("opening_balance") @db.Decimal(18, 2)
  currentBalance Decimal     @default(0) @map("current_balance") @db.Decimal(18, 2)
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  transactions Transaction[]

  @@map("accounts")
}

model Transaction {
  id                String                    @id @default(uuid())
  transactionNumber String                    @unique @map("transaction_number")
  type              TransactionType
  accountId         String                    @map("account_id")
  account           Account                   @relation(fields: [accountId], references: [id])
  amount            Decimal                   @db.Decimal(18, 2)
  // Polymorphic target (Order | PurchaseOrder | Payment | Expense | Invoice) — no DB FK
  referenceType     TransactionReferenceType? @map("reference_type")
  referenceId       String?                   @map("reference_id")
  description       String?
  transactionDate   DateTime                  @map("transaction_date") @db.Date
  createdByUserId   String                    @map("created_by_user_id")
  createdBy         User                      @relation("TransactionCreatedBy", fields: [createdByUserId], references: [id])
  createdAt         DateTime                  @default(now()) @map("created_at")

  @@index([referenceType, referenceId])
  @@index([transactionDate])
  @@index([accountId])
  @@map("transactions")
}

// =========================================================================
// 13. EXPENSES
// =========================================================================

model ExpenseCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")

  expenses Expense[]

  @@map("expense_categories")
}

model Expense {
  id                    String          @id @default(uuid())
  categoryId            String          @map("category_id")
  category              ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount                Decimal         @db.Decimal(18, 2)
  expenseDate           DateTime        @map("expense_date") @db.Date
  description           String?
  responsibleEmployeeId String?         @map("responsible_employee_id")
  responsibleEmployee   Employee?       @relation(fields: [responsibleEmployeeId], references: [id])
  paymentMethod         PaymentMethod   @map("payment_method")
  status                ExpenseStatus   @default(PENDING)
  receiptAttachmentUrl  String?         @map("receipt_attachment_url")
  createdByUserId       String          @map("created_by_user_id")
  createdBy             User            @relation("ExpenseCreatedBy", fields: [createdByUserId], references: [id])
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([expenseDate])
  @@index([status])
  @@map("expenses")
}

// =========================================================================
// 14. EMPLOYEES
// =========================================================================

model Department {
  id                String    @id @default(uuid())
  name              String
  managerEmployeeId String?   @unique @map("manager_employee_id")
  managerEmployee   Employee? @relation("DepartmentManager", fields: [managerEmployeeId], references: [id])
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  positions     Position[]
  employees     Employee[]            @relation("EmployeeDepartment")
  workHistories EmployeeWorkHistory[]

  @@map("departments")
}

model Position {
  id           String     @id @default(uuid())
  title        String
  departmentId String     @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id])
  createdAt    DateTime   @default(now()) @map("created_at")

  employees     Employee[]
  workHistories EmployeeWorkHistory[]

  @@map("positions")
}

model Employee {
  id              String         @id @default(uuid())
  fullName        String         @map("full_name")
  phone           String
  email           String?
  departmentId    String?        @map("department_id")
  department      Department?    @relation("EmployeeDepartment", fields: [departmentId], references: [id])
  positionId      String?        @map("position_id")
  position        Position?      @relation(fields: [positionId], references: [id])
  hireDate        DateTime       @map("hire_date") @db.Date
  status          EmployeeStatus @default(ACTIVE)
  terminationDate DateTime?      @map("termination_date") @db.Date
  salary          Decimal?       @db.Decimal(18, 2)
  address         String?
  deletedAt       DateTime?      @map("deleted_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  user                User?
  managedDepartment   Department?           @relation("DepartmentManager")
  workHistories       EmployeeWorkHistory[]
  attendanceRecords   AttendanceRecord[]
  responsibleOrders   Order[]
  responsibleExpenses Expense[]

  @@map("employees")
}

model EmployeeWorkHistory {
  id            String      @id @default(uuid())
  employeeId    String      @map("employee_id")
  employee      Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  departmentId  String?     @map("department_id")
  department    Department? @relation(fields: [departmentId], references: [id])
  positionId    String?     @map("position_id")
  position      Position?   @relation(fields: [positionId], references: [id])
  effectiveFrom DateTime    @map("effective_from") @db.Date
  effectiveTo   DateTime?   @map("effective_to") @db.Date
  note          String?
  createdAt     DateTime    @default(now()) @map("created_at")

  @@map("employee_work_histories")
}

// =========================================================================
// 15. ATTENDANCE
// =========================================================================

model AttendanceRecord {
  id              String           @id @default(uuid())
  employeeId      String           @map("employee_id")
  employee        Employee         @relation(fields: [employeeId], references: [id])
  workDate        DateTime         @map("work_date") @db.Date
  checkInAt       DateTime?        @map("check_in_at")
  checkOutAt      DateTime?        @map("check_out_at")
  hoursWorked     Decimal?         @map("hours_worked") @db.Decimal(5, 2)
  status          AttendanceStatus @default(PRESENT)
  lateMinutes     Int              @default(0) @map("late_minutes")
  overtimeMinutes Int              @default(0) @map("overtime_minutes")
  notes           String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@unique([employeeId, workDate])
  @@index([workDate])
  @@map("attendance_records")
}

// =========================================================================
// 16. REPORTS
// =========================================================================

model ReportExportJob {
  id                String          @id @default(uuid())
  reportType        ReportType      @map("report_type")
  filters           Json
  format            ReportFormat
  status            ReportJobStatus @default(QUEUED)
  fileUrl           String?         @map("file_url")
  requestedByUserId String          @map("requested_by_user_id")
  requestedBy       User            @relation("ReportJobRequestedBy", fields: [requestedByUserId], references: [id])
  completedAt       DateTime?       @map("completed_at")
  createdAt         DateTime        @default(now()) @map("created_at")

  @@map("report_export_jobs")
}

// =========================================================================
// 17. NOTIFICATIONS
// =========================================================================

model Notification {
  id              String           @id @default(uuid())
  recipientUserId String           @map("recipient_user_id")
  recipient       User             @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  type            NotificationType
  title           String
  message         String
  referenceType   String?          @map("reference_type")
  referenceId     String?          @map("reference_id")
  isRead          Boolean          @default(false) @map("is_read")
  readAt          DateTime?        @map("read_at")
  createdAt       DateTime         @default(now()) @map("created_at")

  @@index([recipientUserId, isRead])
  @@map("notifications")
}

// =========================================================================
// 18. AUDIT LOG
// =========================================================================

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  actorUserId String?  @map("actor_user_id")
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id])
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  oldValue    Json?    @map("old_value")
  newValue    Json?    @map("new_value")
  description String?
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_logs")
}

// =========================================================================
// 19. SETTINGS
// =========================================================================

model CompanySettings {
  id                   String   @id @default(uuid())
  companyName          String   @map("company_name")
  logoUrl              String?  @map("logo_url")
  currency             String   @default("UZS")
  timezone             String   @default("Asia/Tashkent")
  defaultLanguage      String   @default("uz") @map("default_language")
  taxSettings          Json?    @map("tax_settings")
  invoiceSettings      Json?    @map("invoice_settings")
  notificationSettings Json?    @map("notification_settings")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("company_settings")
}

model TaxRate {
  id          String   @id @default(uuid())
  name        String
  ratePercent Decimal  @map("rate_percent") @db.Decimal(5, 2)
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")

  products Product[]

  @@map("tax_rates")
}

// =========================================================================
// INFRASTRUCTURE: transactional outbox for async cross-module cascades
// (Dashboard cache invalidation, Notifications) — see plan §2
// =========================================================================

model OutboxEvent {
  id          String            @id @default(uuid())
  eventType   String            @map("event_type")
  payload     Json
  status      OutboxEventStatus @default(PENDING)
  attempts    Int               @default(0)
  lastError   String?           @map("last_error")
  processedAt DateTime?         @map("processed_at")
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("outbox_events")
}
