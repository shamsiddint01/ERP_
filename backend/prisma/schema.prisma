generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================================
// ENUMS
// =========================================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_INVITE
}

enum PermissionAction {
  VIEW
  CREATE
  EDIT
  DELETE
  APPROVE
  EXPORT
}

// Shared payment-status lifecycle for Order and PurchaseOrder

enum PaymentDirection {
  INBOUND
  OUTBOUND
}

/// The center takes money only in cash or by card.
enum PaymentMethod {
  CASH
  CARD
}

enum PaymentProcessingStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// Polymorphic discriminator for Payment.referenceId (no DB-level FK; enforced in application layer)
enum PaymentReferenceType {
  // referenceId is the payer Student's id, not a specific charge: a tuition
  // payment's actual per-charge breakdown lives in TuitionAllocation,
  // resolved via POST /payments/:id/allocate.
  TUITION_CHARGE
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

enum NotificationType {
  SYSTEM
  STUDENT_ABSENT
  STUDENT_LATE
  STUDENT_REPEATED_ABSENCE
  TUITION_DUE
  TUITION_OVERDUE
  TUITION_PAYMENT_RECEIVED
  EXAM_UPCOMING
  GRADES_PUBLISHED
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  CRITICAL
}

// ----- Education center domain (Phase A) ----------------------------------

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum ClassroomStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum CourseCategoryStatus {
  ACTIVE
  INACTIVE
}

enum CourseStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CourseLevel {
  BEGINNER
  ELEMENTARY
  PRE_INTERMEDIATE
  INTERMEDIATE
  UPPER_INTERMEDIATE
  ADVANCED
}

enum StudentGroupStatus {
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum StudentStatus {
  ACTIVE
  PAUSED
  GRADUATED
  INACTIVE
  LEFT
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
  TRANSFERRED
}

enum TeacherProfileStatus {
  ACTIVE
  INACTIVE
}

enum ScheduleDayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ScheduleRecurrenceType {
  WEEKLY
}

enum ScheduleStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum LessonStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// Phase F. LATE counts as attended (the student was physically present, just
/// tardy); ABSENT and EXCUSED do not — an excused absence is still tracked
/// separately from an unexcused one for reporting, but neither counts toward
/// the attendance percentage. See StudentAttendanceService for the single
/// place this rule is applied.
enum StudentAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

// =========================================================================
// 1. USERS & ROLES (RBAC)
// =========================================================================

model User {
  id                String     @id @default(uuid())
  fullName          String     @map("full_name")
  email             String     @unique
  phone             String?    @unique
  username          String     @unique
  passwordHash      String     @map("password_hash")
  /// The login's current password, AES-256-GCM encrypted
  /// (shared/security/credential-cipher.ts) so an admin can always look it up when
  /// someone loses it. Updated on every password change, including self-service.
  temporaryPassword String?    @map("temporary_password")
  /// Last self-service password change — students and teachers may change
  /// their own password at most once per 12 hours (AuthService.changePassword).
  passwordChangedAt DateTime?  @map("password_changed_at")
  avatarUrl         String?    @map("avatar_url")
  roleId            String     @map("role_id")
  role              Role       @relation(fields: [roleId], references: [id])
  employeeId        String?    @unique @map("employee_id")
  employee          Employee?  @relation(fields: [employeeId], references: [id])
  status            UserStatus @default(PENDING_INVITE)
  lastActiveAt      DateTime?  @map("last_active_at")
  deletedAt         DateTime?  @map("deleted_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  sessions         UserSession[]
  auditLogs        AuditLog[]     @relation("AuditActor")
  notifications    Notification[]
  recordedPayments Payment[]      @relation("PaymentRecordedBy")

  // Education center (Phase A) — optional portal links
  student Student?

  // Student portal
  createdHomeworks       Homework[]             @relation("HomeworkCreatedBy")
  gradedSubmissions      HomeworkSubmission[]   @relation("HomeworkSubmissionGradedBy")
  createdExtraLessons    ExtraLesson[]          @relation("ExtraLessonCreatedBy")
  recordedSalaryPayments TeacherSalaryPayment[] @relation("SalaryPaymentRecordedBy")

  // Phase F
  markedStudentAttendances StudentAttendance[] @relation("StudentAttendanceMarkedBy")

  // Phase G
  tuitionAllocationsMade TuitionAllocation[] @relation("TuitionAllocationAllocatedBy")

  // Phase H
  assessmentsEvaluated Assessment[] @relation("AssessmentEvaluatedBy")

  @@map("users")
}

model Role {
  id           String   @id @default(uuid())
  name         String   @unique
  description  String?
  isSystemRole Boolean  @default(false) @map("is_system_role")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id        String           @id @default(uuid())
  module    String
  action    PermissionAction
  createdAt DateTime         @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String     @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@map("user_sessions")
}

