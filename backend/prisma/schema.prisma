model Payment {
  id                    String                  @id @default(uuid())
  paymentNumber         String                  @unique @map("payment_number")
  direction             PaymentDirection
  amount                Decimal                 @db.Decimal(18, 2)
  currency              String                  @default("UZS")
  method                PaymentMethod
  status                PaymentProcessingStatus @default(PENDING)
  // Polymorphic target — no DB FK, resolved in application layer
  referenceType         PaymentReferenceType?   @map("reference_type")
  referenceId           String?                 @map("reference_id")
  externalTransactionId String?                 @map("external_transaction_id")
  paidAt                DateTime?               @map("paid_at")
  recordedByUserId      String                  @map("recorded_by_user_id")
  recordedBy            User                    @relation("PaymentRecordedBy", fields: [recordedByUserId], references: [id])
  notes                 String?
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")

  tuitionAllocations TuitionAllocation[]

  @@index([referenceType, referenceId])
  @@index([status])
  @@map("payments")
}

// =========================================================================
// 12. FINANCE
// =========================================================================

// =========================================================================
// 13. EXPENSES
// =========================================================================

// =========================================================================
// 14. EMPLOYEES
// =========================================================================

model Employee {
  id              String         @id @default(uuid())
  employeeCode    String         @unique @map("employee_code")
  firstName       String         @map("first_name")
  lastName        String         @map("last_name")
  middleName      String?        @map("middle_name")
  /// Denormalized display name (firstName + middleName + lastName), kept in sync server-side.
  fullName        String         @map("full_name")
  phone           String
  email           String?
  dateOfBirth     DateTime?      @map("date_of_birth") @db.Date
  address         String?
  hireDate        DateTime       @map("hire_date") @db.Date
  status          EmployeeStatus @default(ACTIVE)
  terminationDate DateTime?      @map("termination_date") @db.Date
  notes           String?
  deletedAt       DateTime?      @map("deleted_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  user User?

  // Education center (Phase A/D/E)
  managedBranches      Branch[]               @relation("BranchManager")
  taughtGroups         StudentGroup[]         @relation("GroupTeacher")
  teacherProfile       TeacherProfile?
  taughtSchedules      Schedule[]             @relation("ScheduleTeacher")
  taughtLessons        Lesson[]               @relation("LessonTeacher")
  // Phase H
  examsTeaching        Exam[]                 @relation("ExamTeacher")
  // Student portal
  extraLessonsTeaching ExtraLesson[]          @relation("ExtraLessonTeacher")
  salaryPayments       TeacherSalaryPayment[]

  @@index([status])
  @@map("employees")
}

// =========================================================================
// 15. ATTENDANCE
// =========================================================================

// =========================================================================
// 17. PAYROLL
// =========================================================================

// =========================================================================
// 16. REPORTS
// =========================================================================

// =========================================================================
// 17. NOTIFICATIONS
// =========================================================================

model Notification {
  id              String               @id @default(uuid())
  recipientUserId String               @map("recipient_user_id")
  recipient       User                 @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  type            NotificationType
  severity        NotificationSeverity @default(INFO)
  title           String
  message         String
  referenceType   String?              @map("reference_type")
  referenceId     String?              @map("reference_id")
  actionUrl       String?              @map("action_url")
  isRead          Boolean              @default(false) @map("is_read")
  readAt          DateTime?            @map("read_at")
  createdAt       DateTime             @default(now()) @map("created_at")

  @@index([recipientUserId, isRead])
  @@index([recipientUserId, createdAt])
  @@index([recipientUserId, type, referenceId])
  @@map("notifications")
}

// =========================================================================
// 18. AUDIT LOG
// =========================================================================

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  actorUserId String?  @map("actor_user_id")
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id])
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  oldValue    Json?    @map("old_value")
  newValue    Json?    @map("new_value")
  description String?
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_logs")
}

// =========================================================================
// 19. SETTINGS
// =========================================================================

model CompanySettings {
  id                   String   @id @default(uuid())
  companyName          String   @map("company_name")
  logoUrl              String?  @map("logo_url")
  currency             String   @default("UZS")
  timezone             String   @default("Asia/Tashkent")
  defaultLanguage      String   @default("uz") @map("default_language")
  taxSettings          Json?    @map("tax_settings")
  invoiceSettings      Json?    @map("invoice_settings")
  notificationSettings Json?    @map("notification_settings")
  /// Extensible work-schedule config, e.g. { startTime: "09:00", endTime: "18:00", lateThresholdMinutes: 0 } — read by AttendanceService, never hard-coded.
  workScheduleSettings Json?    @map("work_schedule_settings")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("company_settings")
}

// =========================================================================
// INFRASTRUCTURE: transactional outbox for async cross-module cascades
// (Dashboard cache invalidation, Notifications) — see plan §2
// =========================================================================

// =========================================================================
// EDUCATION CENTER — CORE DOMAIN (Phase A)
// Additive only. Legacy retail models (Product/Warehouse/Order/…) are
// untouched. Teachers are represented by Employee via
// StudentGroup.teacherEmployeeId — a dedicated TeacherProfile arrives in a
// later phase. Money is always Decimal(18,2).
// =========================================================================

model Branch {
  id                String       @id @default(uuid())
  name              String
  code              String       @unique
  address           String?
  phone             String?
  email             String?
  managerEmployeeId String?      @map("manager_employee_id")
  managerEmployee   Employee?    @relation("BranchManager", fields: [managerEmployeeId], references: [id])
  workingHours      String?      @map("working_hours")
  notes             String?
  status            BranchStatus @default(ACTIVE)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  classrooms    Classroom[]
  studentGroups StudentGroup[]
  students      Student[]
  schedules     Schedule[]
  lessons       Lesson[]
  extraLessons  ExtraLesson[]

  @@index([status])
  @@map("branches")
}

model Classroom {
  id         String          @id @default(uuid())
  branchId   String          @map("branch_id")
  branch     Branch          @relation(fields: [branchId], references: [id])
  name       String
  roomNumber String          @map("room_number")
  capacity   Int
  equipment  String?
  notes      String?
  status     ClassroomStatus @default(ACTIVE)
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  studentGroups StudentGroup[]
  schedules     Schedule[]
  lessons       Lesson[]

  @@unique([branchId, roomNumber])
  @@index([branchId])
  @@index([status])
  @@map("classrooms")
}

model CourseCategory {
  id          String               @id @default(uuid())
  name        String
  code        String               @unique
  description String?
  status      CourseCategoryStatus @default(ACTIVE)
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  courses Course[]

  @@index([status])
  @@map("course_categories")
}

model Course {
  id                    String          @id @default(uuid())
  categoryId            String?         @map("category_id")
  category              CourseCategory? @relation(fields: [categoryId], references: [id])
  name                  String
  code                  String          @unique
  description           String?
  level                 CourseLevel?
  durationWeeks         Int?            @map("duration_weeks")
  lessonDurationMinutes Int             @default(90) @map("lesson_duration_minutes")
  defaultTuition        Decimal         @default(0) @map("default_tuition") @db.Decimal(18, 2)
  status                CourseStatus    @default(DRAFT)
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  studentGroups StudentGroup[]
  exams         Exam[]
  extraLessons  ExtraLesson[]

  @@index([categoryId])
  @@index([status])
  @@map("courses")
}

model StudentGroup {
  id                String             @id @default(uuid())
  code              String             @unique
  name              String
  courseId          String             @map("course_id")
  course            Course             @relation(fields: [courseId], references: [id])
  branchId          String             @map("branch_id")
  branch            Branch             @relation(fields: [branchId], references: [id])
  classroomId       String?            @map("classroom_id")
  classroom         Classroom?         @relation(fields: [classroomId], references: [id])
  teacherEmployeeId String?            @map("teacher_employee_id")
  teacherEmployee   Employee?          @relation("GroupTeacher", fields: [teacherEmployeeId], references: [id])
  capacity          Int                @default(12)
  tuitionAmount     Decimal?           @map("tuition_amount") @db.Decimal(18, 2)
  level             CourseLevel?
  startDate         DateTime           @map("start_date") @db.Date
  endDate           DateTime?          @map("end_date") @db.Date
  status            StudentGroupStatus @default(PLANNED)
  notes             String?
  /// Set when the group becomes CANCELLED (cleared if it is reopened). A
  /// cancelled group is purged 10 days later by GroupsCleanupScheduler.
  cancelledAt       DateTime?          @map("cancelled_at")
  /// Set by the purge when the group still has money records (tuition
  /// charges) that must be kept — the group is then hidden everywhere.
  deletedAt         DateTime?          @map("deleted_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  enrollments Enrollment[]
  schedules   Schedule[]
  lessons     Lesson[]
  exams       Exam[]
  homeworks   Homework[]

  @@index([courseId])
  @@index([branchId])
  @@index([classroomId])
  @@index([teacherEmployeeId])
  @@index([status])
  @@index([startDate])
  @@map("student_groups")
}

model Student {
  id               String        @id @default(uuid())
  studentCode      String        @unique @map("student_code")
  firstName        String        @map("first_name")
  lastName         String        @map("last_name")
  fullName         String        @map("full_name")
  dateOfBirth      DateTime?     @map("date_of_birth") @db.Date
  gender           String?
  phone            String?
  email            String?
  address          String?
  photoUrl         String?       @map("photo_url")
  status           StudentStatus @default(ACTIVE)
  registrationDate DateTime      @default(now()) @map("registration_date")
  source           String?
  emergencyContact String?       @map("emergency_contact")
  notes            String?
  branchId         String?       @map("branch_id")
  branch           Branch?       @relation(fields: [branchId], references: [id])
  userId           String?       @unique @map("user_id")
  user             User?         @relation(fields: [userId], references: [id])
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  enrollments              Enrollment[]
  attendances              StudentAttendance[]
  tuitionCharges           TuitionCharge[]
  studentDiscounts         StudentDiscount[]
  assessments              Assessment[]
  homeworkSubmissions      HomeworkSubmission[]
  extraLessonRegistrations ExtraLessonRegistration[]

  @@index([status])
  @@index([branchId])
  @@index([registrationDate])
  @@index([phone])
  @@map("students")
}

model Enrollment {
  id             String           @id @default(uuid())
  studentId      String           @map("student_id")
  student        Student          @relation(fields: [studentId], references: [id])
  groupId        String           @map("group_id")
  group          StudentGroup     @relation(fields: [groupId], references: [id])
  startDate      DateTime         @map("start_date") @db.Date
  endDate        DateTime?        @map("end_date") @db.Date
  status         EnrollmentStatus @default(ACTIVE)
  agreedTuition  Decimal?         @map("agreed_tuition") @db.Decimal(18, 2)
  discountAmount Decimal?         @map("discount_amount") @db.Decimal(18, 2)
  notes          String?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  attendances      StudentAttendance[]
  tuitionCharges   TuitionCharge[]
  studentDiscounts StudentDiscount[]

  @@index([studentId])
  @@index([groupId])
  @@index([status])
  @@index([startDate])
  @@map("enrollments")
}

/// Teaching-specific information layered onto an existing Employee (Phase D).
/// Employee remains the single HR identity; this is an optional 1:1 extension
/// so an employee is only ever eligible to teach a StudentGroup once they
/// have an active profile here — no separate Teacher/person record, and no
/// duplication of Payroll's own compensation model (hourly/per-lesson/
/// per-group rates here are reference figures a future payroll phase can
/// read, not a second calculation engine).
model TeacherProfile {
  id              String               @id @default(uuid())
  employeeId      String               @unique @map("employee_id")
  employee        Employee             @relation(fields: [employeeId], references: [id])
  bio             String?
  specialization  String?
  qualification   String?
  experienceYears Int?                 @map("experience_years")
  status          TeacherProfileStatus @default(ACTIVE)
  hourlyRate      Decimal?             @map("hourly_rate") @db.Decimal(18, 2)
  perLessonRate   Decimal?             @map("per_lesson_rate") @db.Decimal(18, 2)
  perGroupRate    Decimal?             @map("per_group_rate") @db.Decimal(18, 2)
  /// Salary = this % of what the teacher's group students paid in the month (see SalariesService).
  salaryPercent   Decimal?             @map("salary_percent") @db.Decimal(5, 2)
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  @@index([status])
  @@map("teacher_profiles")
}

/// Recurring/planned timetable (Phase E). Deliberately separate from Lesson —
/// a Schedule describes a weekly pattern ("Mon/Wed/Fri 18:00-19:30, Room
/// 204"), a Lesson is one concrete, dated session generated from it.
/// startTime/endTime are plain "HH:mm" strings rather than a Time/DateTime
/// column on purpose: a recurring wall-clock time-of-day has no calendar date
/// or timezone component to get wrong, and zero-padded HH:mm still sorts and
/// compares correctly as plain text.
model Schedule {
  id                String                 @id @default(uuid())
  groupId           String                 @map("group_id")
  group             StudentGroup           @relation(fields: [groupId], references: [id])
  teacherEmployeeId String?                @map("teacher_employee_id")
  teacherEmployee   Employee?              @relation("ScheduleTeacher", fields: [teacherEmployeeId], references: [id])
  classroomId       String?                @map("classroom_id")
  classroom         Classroom?             @relation(fields: [classroomId], references: [id])
  branchId          String                 @map("branch_id")
  branch            Branch                 @relation(fields: [branchId], references: [id])
  dayOfWeek         ScheduleDayOfWeek      @map("day_of_week")
  startTime         String                 @map("start_time")
  endTime           String                 @map("end_time")
  startDate         DateTime               @map("start_date") @db.Date
  endDate           DateTime?              @map("end_date") @db.Date
  recurrenceType    ScheduleRecurrenceType @default(WEEKLY) @map("recurrence_type")
  status            ScheduleStatus         @default(ACTIVE)
  notes             String?
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  lessons Lesson[]

  @@index([groupId])
  @@index([teacherEmployeeId])
  @@index([classroomId])
  @@index([branchId])
  @@index([dayOfWeek])
  @@index([status])
  @@map("schedules")
}

/// A single, concrete class session (Phase E). May be generated from a
/// Schedule (scheduleId set) or created ad hoc (null). The
/// (scheduleId, scheduledStart) unique constraint is what makes lesson
/// generation idempotent — re-running it for an overlapping range can never
/// create duplicates, generated or not.
model Lesson {
  id                String       @id @default(uuid())
  groupId           String       @map("group_id")
  group             StudentGroup @relation(fields: [groupId], references: [id])
  scheduleId        String?      @map("schedule_id")
  schedule          Schedule?    @relation(fields: [scheduleId], references: [id])
  teacherEmployeeId String?      @map("teacher_employee_id")
  teacherEmployee   Employee?    @relation("LessonTeacher", fields: [teacherEmployeeId], references: [id])
  classroomId       String?      @map("classroom_id")
  classroom         Classroom?   @relation(fields: [classroomId], references: [id])
  branchId          String       @map("branch_id")
  branch            Branch       @relation(fields: [branchId], references: [id])
  scheduledStart    DateTime     @map("scheduled_start")
  scheduledEnd      DateTime     @map("scheduled_end")
  actualStart       DateTime?    @map("actual_start")
  actualEnd         DateTime?    @map("actual_end")
  topic             String?
  homework          String?
  notes             String?
  status            LessonStatus @default(SCHEDULED)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  studentAttendances StudentAttendance[]

  @@unique([scheduleId, scheduledStart])
  @@index([groupId])
  @@index([scheduleId])
  @@index([teacherEmployeeId])
  @@index([classroomId])
  @@index([branchId])
  @@index([status])
  @@index([scheduledStart])
  @@map("lessons")
}

/// One student's attendance mark for one Lesson (Phase F). Deliberately its
/// own model, never merged with Employee AttendanceRecord — a different
/// entity, a different audience, a different lifecycle. enrollmentId is
/// nullable: it is always resolved and stored by StudentAttendanceService at
/// creation time (the enrollment valid for the lesson's date), but is kept
/// nullable at the schema level — mirroring Lesson.scheduleId's own
/// nullable-FK-for-resilience precedent — rather than a hard NOT NULL that
/// would make a future historical-data import or an Enrollment data-model
/// change a breaking migration.
model StudentAttendance {
  id             String                  @id @default(uuid())
  lessonId       String                  @map("lesson_id")
  lesson         Lesson                  @relation(fields: [lessonId], references: [id])
  studentId      String                  @map("student_id")
  student        Student                 @relation(fields: [studentId], references: [id])
  enrollmentId   String?                 @map("enrollment_id")
  enrollment     Enrollment?             @relation(fields: [enrollmentId], references: [id])
  status         StudentAttendanceStatus
  markedAt       DateTime                @default(now()) @map("marked_at")
  markedByUserId String                  @map("marked_by_user_id")
  markedBy       User                    @relation("StudentAttendanceMarkedBy", fields: [markedByUserId], references: [id])
  notes          String?
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  @@unique([lessonId, studentId])
  @@index([lessonId])
  @@index([studentId])
  @@index([enrollmentId])
  @@index([status])
  @@index([markedByUserId])
  @@map("student_attendances")
}

/// Phase G. No hard DB unique constraint on (enrollmentId, billingPeriod) by
/// design — duplicate billing is prevented at the service layer (a
/// transaction-scoped advisory lock + a live check), specifically so the
/// spec's "unless explicitly overridden by a safe business rule" escape
/// hatch can exist at all. A genuine unique constraint could never be
/// overridden.
enum TuitionChargeStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

/// value's meaning depends on type: a percentage (0-100) for PERCENTAGE, a
/// flat currency amount for every other type (FIXED/SIBLING/SCHOLARSHIP/
/// PROMOTIONAL/CUSTOM) — SIBLING/SCHOLARSHIP/PROMOTIONAL/CUSTOM are all
/// fixed-style reasons/labels for a discount rather than distinct math, kept
/// separate from FIXED so reporting can tell *why* a discount was granted.
enum DiscountType {
  PERCENTAGE
  FIXED
  SIBLING
  SCHOLARSHIP
  PROMOTIONAL
  CUSTOM
}

/// One billing period's tuition charge for one Enrollment (Phase G). Money
/// fields are frozen at creation time — a StudentDiscount added, changed, or
/// removed afterward never silently rewrites an already-created charge
/// (spec: "Do not change historical charges silently"); only a brand new
/// charge picks up the student's then-current active discounts. amount/
/// discountAmount/netAmount are immutable after creation (see
/// UpdateTuitionChargeDto) — a genuine correction cancels this charge and
/// bills a new one, rather than mutating posted financial history.
model TuitionCharge {
  id             String              @id @default(uuid())
  studentId      String              @map("student_id")
  student        Student             @relation(fields: [studentId], references: [id])
  enrollmentId   String              @map("enrollment_id")
  enrollment     Enrollment          @relation(fields: [enrollmentId], references: [id])
  /// Freeform "YYYY-MM" bucket — a billing period is a coarse calendar
  /// month, not a specific instant, so (like Schedule's HH:mm strings) a
  /// plain sortable string avoids any timezone-conversion risk a DateTime
  /// would carry for a value that was never really a point in time.
  billingPeriod  String              @map("billing_period")
  amount         Decimal             @db.Decimal(18, 2)
  discountAmount Decimal             @default(0) @map("discount_amount") @db.Decimal(18, 2)
  netAmount      Decimal             @map("net_amount") @db.Decimal(18, 2)
  dueDate        DateTime            @map("due_date") @db.Date
  status         TuitionChargeStatus @default(PENDING)
  description    String?
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  allocations TuitionAllocation[]

  @@index([studentId])
  @@index([enrollmentId])
  @@index([billingPeriod])
  @@index([status])
  @@index([dueDate])
  @@map("tuition_charges")
}

/// A payment covering one or more TuitionCharges (Phase G) — never merges
/// with the simpler 1:1 Payment<->Invoice/Order reconciliation elsewhere in
/// this system. @@unique([paymentId, tuitionChargeId]) makes "allocate more
/// to the same charge from the same payment" an update-in-place rather than
/// a second row, which is what POST /payments/:id/allocate relies on to be
/// safely re-callable.
model TuitionAllocation {
  id                String        @id @default(uuid())
  paymentId         String        @map("payment_id")
  payment           Payment       @relation(fields: [paymentId], references: [id])
  tuitionChargeId   String        @map("tuition_charge_id")
  tuitionCharge     TuitionCharge @relation(fields: [tuitionChargeId], references: [id])
  amount            Decimal       @db.Decimal(18, 2)
  allocatedByUserId String        @map("allocated_by_user_id")
  allocatedBy       User          @relation("TuitionAllocationAllocatedBy", fields: [allocatedByUserId], references: [id])
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@unique([paymentId, tuitionChargeId])
  @@index([paymentId])
  @@index([tuitionChargeId])
  @@map("tuition_allocations")
}

/// A reusable discount definition (Phase G) — a small catalog, like
/// ExpenseCategory, granted to specific students via StudentDiscount below.
model Discount {
  id          String       @id @default(uuid())
  name        String
  type        DiscountType
  value       Decimal      @db.Decimal(18, 2)
  description String?
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  studentDiscounts StudentDiscount[]

  @@index([isActive])
  @@index([type])
  @@map("discounts")
}

/// Grants one Discount to one Student (Phase G) — scoped to a single
/// Enrollment when enrollmentId is set, or the student's every enrollment
/// when null. Only ever read when a NEW TuitionCharge is created; never
/// retroactively applied to existing charges.
model StudentDiscount {
  id           String      @id @default(uuid())
  studentId    String      @map("student_id")
  student      Student     @relation(fields: [studentId], references: [id])
  discountId   String      @map("discount_id")
  discount     Discount    @relation(fields: [discountId], references: [id])
  enrollmentId String?     @map("enrollment_id")
  enrollment   Enrollment? @relation(fields: [enrollmentId], references: [id])
  startDate    DateTime    @map("start_date") @db.Date
  endDate      DateTime?   @map("end_date") @db.Date
  isActive     Boolean     @default(true) @map("is_active")
  notes        String?
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@index([studentId])
  @@index([discountId])
  @@index([enrollmentId])
  @@index([isActive])
  @@map("student_discounts")
}

// =========================================================================
// 18. EXAMS & ACADEMIC ASSESSMENT (Phase H)
// =========================================================================

enum ExamType {
  QUIZ
  MIDTERM
  FINAL
  MOCK
  PLACEMENT
  OTHER
}

enum ExamStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

/// One exam/quiz/test event for a single StudentGroup. `courseId` is stored
/// alongside `groupId` (rather than derived through group.course) so an
/// exam's course never silently changes if the group is later reassigned to
/// a different course — the same "store what was true at the time"
/// rationale as OrderItem snapshotting its unit price.
model Exam {
  id                String       @id @default(uuid())
  title             String
  courseId          String       @map("course_id")
  course            Course       @relation(fields: [courseId], references: [id])
  groupId           String       @map("group_id")
  group             StudentGroup @relation(fields: [groupId], references: [id])
  teacherEmployeeId String?      @map("teacher_employee_id")
  teacherEmployee   Employee?    @relation("ExamTeacher", fields: [teacherEmployeeId], references: [id])
  date              DateTime     @map("date")
  maxScore          Decimal      @map("max_score") @db.Decimal(6, 2)
  passingScore      Decimal      @map("passing_score") @db.Decimal(6, 2)
  type              ExamType
  status            ExamStatus   @default(SCHEDULED)
  notes             String?
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  assessments Assessment[]

  @@index([courseId])
  @@index([groupId])
  @@index([teacherEmployeeId])
  @@index([status])
  @@index([date])
  @@map("exams")
}

/// One student's result for one Exam. `percentage`/`grade` are computed at
/// evaluation time from `score`/`exam.maxScore` via the configurable grading
/// scale (shared/grading/grading-scale.ts) and never recomputed
/// retroactively if the scale changes later — same "freeze at the moment of
/// the real-world event" rule Phase G's TuitionCharge.discountAmount
/// follows. @@unique([examId, studentId]) is a genuine hard constraint (no
/// override, unlike TuitionCharge's duplicate-billing guard) — the spec is
/// unconditional: one assessment per student per exam.
model Assessment {
  id                String   @id @default(uuid())
  examId            String   @map("exam_id")
  exam              Exam     @relation(fields: [examId], references: [id])
  studentId         String   @map("student_id")
  student           Student  @relation(fields: [studentId], references: [id])
  score             Decimal  @db.Decimal(6, 2)
  percentage        Decimal  @db.Decimal(5, 2)
  grade             String
  comment           String?
  evaluatedByUserId String   @map("evaluated_by_user_id")
  evaluatedBy       User     @relation("AssessmentEvaluatedBy", fields: [evaluatedByUserId], references: [id])
  evaluatedAt       DateTime @map("evaluated_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([examId, studentId])
  @@index([examId])
  @@index([studentId])
  @@map("assessments")
}

// =========================================================================
// STUDENT PORTAL — homework and extra lessons
// =========================================================================

enum HomeworkSubmissionStatus {
  SUBMITTED
  GRADED
}

/// A homework assignment given to a whole group by its teacher (or staff).
model Homework {
  id              String       @id @default(uuid())
  groupId         String       @map("group_id")
  group           StudentGroup @relation(fields: [groupId], references: [id])
  title           String
  description     String?
  dueDate         DateTime     @map("due_date")
  maxScore        Int          @default(100) @map("max_score")
  createdByUserId String       @map("created_by_user_id")
  createdBy       User         @relation("HomeworkCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  submissions HomeworkSubmission[]

  @@index([groupId, dueDate])
  @@map("homeworks")
}

/// One student's answer to one homework — at most one per (homework, student); resubmitting overwrites it until it is graded.
model HomeworkSubmission {
  id             String                   @id @default(uuid())
  homeworkId     String                   @map("homework_id")
  homework       Homework                 @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId      String                   @map("student_id")
  student        Student                  @relation(fields: [studentId], references: [id])
  answerText     String                   @map("answer_text")
  link           String?
  status         HomeworkSubmissionStatus @default(SUBMITTED)
  submittedAt    DateTime                 @default(now()) @map("submitted_at")
  score          Int?
  feedback       String?
  gradedAt       DateTime?                @map("graded_at")
  gradedByUserId String?                  @map("graded_by_user_id")
  gradedBy       User?                    @relation("HomeworkSubmissionGradedBy", fields: [gradedByUserId], references: [id])

  @@unique([homeworkId, studentId])
  @@index([studentId])
  @@map("homework_submissions")
}

enum ExtraLessonStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

/// An extra (additional) lesson the center announces; students sign up themselves until it is full.
model ExtraLesson {
  id                String            @id @default(uuid())
  title             String
  description       String?
  teacherEmployeeId String?           @map("teacher_employee_id")
  teacherEmployee   Employee?         @relation("ExtraLessonTeacher", fields: [teacherEmployeeId], references: [id])
  courseId          String?           @map("course_id")
  course            Course?           @relation(fields: [courseId], references: [id])
  branchId          String?           @map("branch_id")
  branch            Branch?           @relation(fields: [branchId], references: [id])
  room              String?
  startsAt          DateTime          @map("starts_at")
  endsAt            DateTime          @map("ends_at")
  capacity          Int
  status            ExtraLessonStatus @default(SCHEDULED)
  createdByUserId   String            @map("created_by_user_id")
  createdBy         User              @relation("ExtraLessonCreatedBy", fields: [createdByUserId], references: [id])
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  registrations ExtraLessonRegistration[]

  @@index([startsAt])
  @@map("extra_lessons")
}

/// A student's place in an extra lesson. Cancelling deletes the row, freeing the seat.
model ExtraLessonRegistration {
  id            String      @id @default(uuid())
  extraLessonId String      @map("extra_lesson_id")
  extraLesson   ExtraLesson @relation(fields: [extraLessonId], references: [id], onDelete: Cascade)
  studentId     String      @map("student_id")
  student       Student     @relation(fields: [studentId], references: [id])
  createdAt     DateTime    @default(now()) @map("created_at")

  @@unique([extraLessonId, studentId])
  @@index([studentId])
  @@map("extra_lesson_registrations")
}

// =========================================================================
// TEACHER SALARY — a % of tuition collected from the teacher's groups
// =========================================================================

/// One salary payout to a teacher for a month ("YYYY-MM"); several (partial) payouts per month are allowed.
model TeacherSalaryPayment {
  id                String   @id @default(uuid())
  teacherEmployeeId String   @map("teacher_employee_id")
  teacherEmployee   Employee @relation(fields: [teacherEmployeeId], references: [id])
  period            String
  amount            Decimal  @db.Decimal(18, 2)
  paidAt            DateTime @default(now()) @map("paid_at")
  note              String?
  recordedByUserId  String   @map("recorded_by_user_id")
  recordedBy        User     @relation("SalaryPaymentRecordedBy", fields: [recordedByUserId], references: [id])
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([teacherEmployeeId, period])
  @@map("teacher_salary_payments")
}
