# Dependencies
node_modules/

# This project uses npm (package-lock.json is the committed lockfile).
# Ignore other package managers' lockfiles so an accidental `pnpm install`/
# `yarn install` never gets committed alongside it and causes drift.
pnpm-lock.yaml
pnpm-workspace.yaml
yarn.lock

# Build output
dist/
dist-ssr/
build/
out/
coverage/
*.tsbuildinfo

# Environment variables / secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json

# Database files
*.sqlite
*.sqlite3
*.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Temporary files
tmp/
temp/
*.tmp
*.temp

# IDE / editor files
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini
backups/
.public-logs/
